    {"rule_id":"N-MILHO-CQFS-2016","cultura":"milho","nutriente_corretivo":"N","regiao":"RS/SC","condicao_entrada":"MO, precedente, rendimento alvo","parametros_obrigatorios":["mo_pct","precedente_classe","rendimento_t_ha","sistema_preparo","residuo_classe","populacao_plantas_ha"],"parametros_opcionais":["biomassa_residuo_t_ha","irrigacao"],"formula":"base_por_MO_precedente + 15*(rendimento-6) se rendimento>6; aplicar modificadores CQFS sem dupla contagem","unidade_entrada":"% MO; t/ha; plantas/ha","unidade_saida":"kg N/ha","limites":"base 0-90; incremento população >65000: 10 kg por 5000 plantas","excecoes":"biomassa e rendimento extremos exigem revisão","interpretacao":"tabela normativa regional","fonte":"CQFS-RS/SC 2016 pp.125-127","instituicao":"SBCS-NRS/CQFS","ano":2016,"pagina_tabela":"125-127","url":"https://www.sbcs-nrs.org.br/docs/Manual_de_Calagem_e_Adubacao_para_os_Estados_do_RS_e_de_SC-2016.pdf","confianca":"alta","status":"READY_FOR_IMPLEMENTATION"},
    {"rule_id":"N-TRIGO-EMBRAPA-2026","cultura":"trigo","nutriente_corretivo":"N","regiao":"RS/SC","condicao_entrada":"MO, soja/milho precedente, rendimento","parametros_obrigatorios":["mo_pct","precedente","rendimento_t_ha"],"parametros_opcionais":["estadio_aplicacao","cultivar_responsiva_proteina"],"formula":"base tabela: MO<=2.5 soja60 milho80; 2.6-5 soja40 milho60; >5 <=20; +20/t após soja ou +30/t após milho acima de 3 t/ha","unidade_entrada":"% MO; t/ha","unidade_saida":"kg N/ha","limites":"semeadura 15-20; restante perfilhamento-alongamento","excecoes":"N tardio é módulo de qualidade, nunca default","interpretacao":"tabela regional mais recente consultada","fonte":"Embrapa Trigo 2026 Tabela 3 pp.29-33","instituicao":"Embrapa Trigo","ano":2026,"pagina_tabela":"29-33","url":"https://www.infoteca.cnptia.embrapa.br/infoteca/bitstream/doc/1188314/1/Informacoes-Tecnicas-2026-online-CGPE.pdf","confianca":"alta","status":"READY_FOR_IMPLEMENTATION"},
    {"rule_id":"N-CANOLA-CQFS-2016","cultura":"canola","nutriente_corretivo":"N","regiao":"RS/SC","condicao_entrada":"MO e rendimento","parametros_obrigatorios":["mo_pct","rendimento_t_ha"],"parametros_opcionais":["estadio","chuva_prevista"],"formula":"base 60/40/<=30 por MO +20*(rendimento-1.5) se acima de 1.5","unidade_entrada":"% MO; t/ha","unidade_saida":"kg N/ha","limites":"20-30 kg na semeadura; cobertura quarta folha expandida","excecoes":"parcelamento depende de textura e lixiviação","interpretacao":"dose de referência regional","fonte":"CQFS 2016 p.119; Tomm et al. 2009 pp.50-53","instituicao":"CQFS/Embrapa Trigo","ano":2016,"pagina_tabela":"119","url":"https://www.sbcs-nrs.org.br/docs/Manual_de_Calagem_e_Adubacao_para_os_Estados_do_RS_e_de_SC-2016.pdf","confianca":"alta","status":"READY_FOR_IMPLEMENTATION"},
    {"rule_id":"N-GRAMINEA-INVERNO-CQFS-2016","cultura":"pastagem de inverno","nutriente_corretivo":"N","regiao":"RS/SC","condicao_entrada":"MO, anual/perene, rendimento MS, antecedente","parametros_obrigatorios":["mo_pct","tipo_pastagem","rendimento_ms_t_ha","precedente"],"parametros_opcionais":["numero_usos","modo_exploracao"],"formula":"faixa CQFS por MO +30*(MS-6) anual ou +30*(MS-8) perene; após leguminosa usar mínimo","unidade_entrada":"% MO; t MS/ha","unidade_saida":"kg N/ha","limites":"15-30 semeadura; 2-4 coberturas","excecoes":"leguminosa inoculada não recebe N; falha comprovada 20 após cada 2 usos","interpretacao":"faixas, não interpolar automaticamente dentro da faixa","fonte":"CQFS 2016 pp.141-147","instituicao":"CQFS-RS/SC","ano":2016,"pagina_tabela":"141-142","url":"https://www.sbcs-nrs.org.br/docs/Manual_de_Calagem_e_Adubacao_para_os_Estados_do_RS_e_de_SC-2016.pdf","confianca":"alta","status":"READY_FOR_IMPLEMENTATION"},
    {"rule_id":"N-ARROZ-SOSBAI-2025","cultura":"arroz irrigado","nutriente_corretivo":"N","regiao":"Sul do Brasil","condicao_entrada":"MO e classe de resposta SOSBAI","parametros_obrigatorios":["mo_pct","classe_resposta","sistema_semeadura"],"parametros_opcionais":["leguminosa_ms_t_ha","residuo_graminea","dias_para_inundacao"],"formula":"tabela SOSBAI 2025: MO<=2.5 110/135/165; 2.6-5 100/120/150; >5 <=90/110/135; leguminosa >3 t reduz15%","unidade_entrada":"% MO; classe","unidade_saida":"kg N/ha","limites":"10-30 base; parcelamento conforme sistema","excecoes":"conflita com CQFS 2016; escolher edição explicitamente","interpretacao":"SOSBAI 2025 prevalece para arroz irrigado Sul quando selecionada","fonte":"SOSBAI 2025 Tabela 4.5 pp.46-47","instituicao":"SOSBAI/Embrapa/Epagri/IRGA/UFSM","ano":2025,"pagina_tabela":"46-47","url":"https://www.sosbai.com.br/uploads/documentos/recomendacoes-tecnicas-da-pesquisa-para-o-sul-do-brasil_310.pdf","confianca":"alta","status":"REQUIRES_AGRONOMIST_REVIEW"},
    {"rule_id":"S-TRIGO-EMBRAPA-2026","cultura":"trigo","nutriente_corretivo":"S","regiao":"RS/SC","condicao_entrada":"S solo <5 mg/dm3 e método válido","parametros_obrigatorios":["s_mg_dm3","metodo_extracao"],"parametros_opcionais":["textura","mo_pct"],"formula":"20 a 30 kg S/ha","unidade_entrada":"mg S/dm3","unidade_saida":"kg S/ha","limites":"somente com deficiência comprovada","excecoes":"métodos não equivalentes não podem compartilhar limiar","interpretacao":"regra condicional","fonte":"Embrapa Trigo 2026 p.33","instituicao":"Embrapa Trigo","ano":2026,"pagina_tabela":"33","url":"https://www.infoteca.cnptia.embrapa.br/infoteca/bitstream/doc/1188314/1/Informacoes-Tecnicas-2026-online-CGPE.pdf","confianca":"alta","status":"READY_FOR_IMPLEMENTATION"},
    {"rule_id":"S-CANOLA-CQFS-2016","cultura":"canola","nutriente_corretivo":"S","regiao":"RS/SC","condicao_entrada":"S <10 mg/dm3 por método compatível","parametros_obrigatorios":["s_mg_dm3","metodo_extracao"],"parametros_opcionais":["mo_pct","textura"],"formula":"20 kg S/ha","unidade_entrada":"mg S/dm3","unidade_saida":"kg S/ha","limites":"deficiência confirmada","excecoes":"não converter exemplo de gesso em regra universal","interpretacao":"dose condicional","fonte":"Tomm et al. 2009 p.53; CQFS 2016","instituicao":"Embrapa Trigo/CQFS","ano":2009,"pagina_tabela":"53","url":"https://www.infoteca.cnptia.embrapa.br/infoteca/bitstream/doc/853791/1/TecnologiaparaaproducaodeCanola.pdf","confianca":"alta","status":"READY_FOR_IMPLEMENTATION"},
