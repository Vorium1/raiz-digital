# Banco / operação
DATA_MODE=database
# DATABASE_URL: papel administrativo, usado só por migrations/seed (dono das tabelas).
DATABASE_URL=postgresql://raiz:raiz@localhost:5432/raiz_digital
DATABASE_SSL=disable
DB_POOL_MAX=10
# APP_DATABASE_URL: papel restrito (raiz_app, criado pela migration 006) que a
# aplicação usa em runtime. Sem BYPASSRLS e sem ser dono das tabelas, para que
# o isolamento multiempresa (RLS) seja realmente aplicado. Defina a senha com
# `npm run db:set-app-password` (variável APP_DB_ROLE_PASSWORD).
APP_DATABASE_URL=postgresql://raiz_app:troque-por-uma-senha-gerada@localhost:5432/raiz_digital
APP_DB_ROLE_PASSWORD=

# Autenticação
AUTH_SECRET=troque-por-um-segredo-aleatorio-com-32-ou-mais-bytes
APP_URL=http://localhost:3000

# Seed local opcional (somente desenvolvimento)
SEED_TENANT_NAME=Raiz Digital Demo
SEED_ADMIN_NAME=Administrador Raiz
SEED_ADMIN_EMAIL=admin@raiz.local
SEED_ADMIN_PASSWORD=

# Adaptadores substituíveis
AI_PROVIDER=mock
AI_API_KEY=
EMAIL_PROVIDER=console
EMAIL_API_KEY=
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_BUCKET=raiz-digital
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
