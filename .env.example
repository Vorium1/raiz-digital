# Banco / operação
# Antes de promover um ambiente comercial, configure os valores reais e rode:
#   npm run check:production-readiness
# O comando nunca imprime os segredos e bloqueia placeholders/configurações inseguras.
DATA_MODE=database
# DATABASE_URL: papel administrativo, usado só por migrations/seed (dono das tabelas).
# Local (docker-compose): postgresql://raiz:raiz@localhost:5432/raiz_digital, DATABASE_SSL=disable.
# Produção (Neon, decisão de 2026-09-08 -- ver docs/PROJECT_STATE.md): connection string do painel
# da Neon (postgresql://usuario:senha@...neon.tech/banco?sslmode=require), DATABASE_SSL=require.
DATABASE_URL=postgresql://raiz:raiz@localhost:5432/raiz_digital
DATABASE_SSL=disable
DB_POOL_MAX=10
# APP_DATABASE_URL: papel restrito (raiz_app, criado pela migration 006) que a
# aplicação usa em runtime. Sem BYPASSRLS e sem ser dono das tabelas, para que
# o isolamento multiempresa (RLS) seja realmente aplicado. Defina a senha com
# `npm run db:set-app-password` (variável APP_DB_ROLE_PASSWORD) -- em produção,
# use o MESMO host/porta/banco do DATABASE_URL acima, só trocando usuário/senha.
APP_DATABASE_URL=postgresql://raiz_app:troque-por-uma-senha-gerada@localhost:5432/raiz_digital
APP_DB_ROLE_PASSWORD=

# Autenticação
AUTH_SECRET=troque-por-um-segredo-aleatorio-com-32-ou-mais-bytes
APP_URL=http://localhost:3000

# Seed local opcional (somente desenvolvimento)
SEED_TENANT_NAME=Raiz Digital Demo
SEED_ADMIN_NAME=Administrador Raiz
SEED_ADMIN_EMAIL=admin@raiz.local
SEED_ADMIN_PASSWORD=

# Adaptadores substituíveis
AI_PROVIDER=mock
AI_API_KEY=
# Chaves reais dos provedores de IA usados na pesquisa periódica de conhecimento
# e na geração assistida. Deixe em branco para desativar o provedor específico.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Modelo usado somente na recomendação assistida, quando Gemini for o provider disponível.
# GEMINI_PRESCRIPTION_MODEL=gemini-3.6-flash

# Assistente RAIZ (Fase 4G) -- roteamento local-first/híbrido, ver docs/RAIZ_2.0_FASE4G_FECHAMENTO.md.
# Padrão SEMPRE "local" -- ter GEMINI_API_KEY configurada acima NUNCA basta sozinha pra ligar o híbrido.
RAIZ_ASSISTANT_MODE=local
# RAIZ_ASSISTANT_MODE=hybrid
RAIZ_ASSISTANT_MAX_GENERATIVE_CALLS_PER_USER_DAY=20
RAIZ_ASSISTANT_MAX_GENERATIVE_CALLS_PER_TENANT_DAY=200
RAIZ_ASSISTANT_GENERATIVE_TIMEOUT_MS=15000
# RAIZ_ASSISTANT_GENERATIVE_MAX_TOKENS=8000

# E-mail. `console` só registra o conteúdo no servidor e é adequado ao desenvolvimento local.
# Para recuperação de senha real em Preview/produção, use `resend` e configure as duas variáveis abaixo.
# EMAIL_FROM precisa usar um remetente/domínio autorizado no provedor.
EMAIL_PROVIDER=console
# EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=RAIZ Digital <no-reply@seudominio.com.br>

# Arquivo bruto/original do laboratório.
# Desenvolvimento local pode usar `local`. Ambiente comercial/serverless deve usar `s3`.
# O adapter usa API S3 + Signature V4 e funciona com AWS S3, Cloudflare R2, MinIO e equivalentes.
STORAGE_PROVIDER=local
# STORAGE_PROVIDER=s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=raiz-digital
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Opcional quando o provedor usa credenciais temporárias (STS).
S3_SESSION_TOKEN=

# Snapshot IMUTÁVEL de relatório: em Vercel a RAIZ usa `inline` no PostgreSQL/Neon.
# Em produção, deixe explícito para não acoplar relatório ao provider bruto.
# REPORT_STORAGE_PROVIDER=inline

# Mercado Pago — deixe vazio até a homologação financeira.
# Access Token: credencial privada usada apenas no backend para consultar o recurso oficial após cada webhook.
# Webhook Secret: assinatura secreta configurada no painel do Mercado Pago para validar x-signature.
# Nunca exponha nenhum dos dois no frontend, NEXT_PUBLIC_* ou repositório.
# Endpoint RAIZ a cadastrar no provedor: https://SEU-DOMINIO/api/webhooks/mercado-pago
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
# Gate separado das credenciais: manter `false` durante configuração/homologação de webhook.
# Só mude para `true` no ambiente onde usuários podem efetivamente abrir Checkout Pro.
MERCADO_PAGO_CHECKOUT_ENABLED=false

# Mapa-base geográfico.
# `auto`: usa Google Satellite quando a chave de browser está configurada; caso contrário, Leaflet.
# `google`: exige Maps JavaScript API no browser; se a chave estiver ausente ou o carregamento falhar,
# a aplicação cai para o mapa-base de contingência sem alterar raster NDVI, geometria ou coordenadas.
# `leaflet`: força a contingência Leaflet/Esri/OSM.
NEXT_PUBLIC_RAIZ_MAP_PROVIDER=auto
# Chave de browser da Google Maps JavaScript API. É pública por desenho e DEVE ser restrita por
# HTTP referrer + API restriction no Google Cloud Console. Nunca reutilize credencial de backend aqui.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# NDVI por satélite (Sentinel-2 via Copernicus Data Space Ecosystem, tier gratuito).
# Crie uma conta gratuita em https://dataspace.copernicus.eu/, gere um "OAuth client"
# (client credentials) no painel e cole os dois valores abaixo. Sem isso, o botão
# "Buscar leitura" de vigor por satélite mostra um erro claro em vez de dado inventado.
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
