    {"rule_id":"LIME-PRNT","cultura":"geral","nutriente_corretivo":"calcário","regiao":"RS/SC","condicao_entrada":"necessidade PRNT100 e PRNT produto","parametros_obrigatorios":["dose_prnt100","prnt_produto"],"parametros_opcionais":["pn","reatividade","granulometria","cao","mgo"],"formula":"dose_comercial=dose_prnt100*100/PRNT; PRNT=PN*RE/100","unidade_entrada":"kg/ha; %","unidade_saida":"kg produto/ha","limites":"registrar granulometria e laudo","excecoes":"limite superficial 5 t/ha PRNT100 no contexto CQFS de plantio direto consolidado","interpretacao":"conversão matemática, não escolha de produto","fonte":"CQFS 2016 pp.296-301","instituicao":"CQFS-RS/SC","ano":2016,"pagina_tabela":"296-301","url":"https://www.sbcs-nrs.org.br/docs/Manual_de_Calagem_e_Adubacao_para_os_Estados_do_RS_e_de_SC-2016.pdf","confianca":"alta","status":"READY_FOR_IMPLEMENTATION"},
